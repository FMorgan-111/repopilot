# RepoPilot Environment Variables
# Copy only non-secret settings. Inject credentials through your process
# environment or deployment runtime secret store; never commit real tokens.

# GitHub personal access token (needs repo scope for private repos)
GITHUB_TOKEN=

# OpenAI-compatible API key
LLM_API_KEY=

# OpenAI-compatible endpoint
OPENAI_BASE_URL=https://linoapi.com.cn/v1

# Primary model
LLM_MODEL=gemini-3.5-flash:stable

# Optional independent escalation provider. Escalation remains disabled unless
# REPOPILOT_ESCALATION_ENABLED=1 and LLM_ESCALATION_API_KEY is injected at run time.
LLM_ESCALATION_MODEL=claude-opus-4-8:stable
LLM_ESCALATION_BASE_URL=https://linoapi.com.cn/v1
LLM_ESCALATION_API_KEY=
REPOPILOT_ESCALATION_ENABLED=0
REPOPILOT_ESCALATION_AFTER_NO_PROGRESS=2

# Optional fail-closed tool sandbox. The image must already exist locally and
# be pinned by image ID or registry digest; RepoPilot always uses --pull=never.
# REPOPILOT_TOOL_OCI_BACKEND=docker
# REPOPILOT_TOOL_OCI_IMAGE=sha256:<64-lowercase-hex-characters>
# REPOPILOT_TOOL_PYTHON_EXECUTABLE=/usr/local/bin/python
# REPOPILOT_TOOL_PROJECT_EXECUTABLES={"npm":"/usr/bin/npm"}
